# model weights -- single-copy on the external drive, never in git
models/
experiments/*/adapter/*.safetensors
*.safetensors
**/checkpoints/
**/snapshots/
# throwaway run dirs (dry-run adapters, per-checkpoint eval copies)
experiments/*/tmp/

# regenerable data dumps
**/dataset/raw_output/
*.bak

# run logs / watchdog markers (train.log stays trackable)
**/results/**/*.log
!**/results/**/train.log
**/results/**/.*.done
**/results/**/.*_progress_steps
**/results/**/.best_step

# python venv (dir or symlink; setup_env.sh creates it here)
.venv
# pinned jac binary for grading jac-data-gen evals (run_function_eval.sh)
.jac-grader/
# jac-data-gen private eval material: grader rows quote hidden test asserts,
# reference samples are the private solutions ("never train on these")
**/results/function_v1_*/**/results.jsonl
**/results/function_v1_*/reference/samples*.jsonl
**/results/function_v1_*/reference/tests.jsonl

# tooling caches
.jac/
__pycache__/
.DS_Store
